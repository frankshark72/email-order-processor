# Email Order Processor — Variabili d'ambiente
# Copia questo file in .env e compila con i valori reali.
# Il file .env NON va mai committato (già in .gitignore).

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email in entrata (IMAP) ───────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ── Email in uscita (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# EspoCRM (usato anche dalle OpenClaw skills)
ESPOCRM_URL=http://100.64.0.2/espocrm
ESPOCRM_API_KEY=
